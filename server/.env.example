PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/certificate-generator

# Long random string used to sign login cookies (required when NODE_ENV=production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The first account created on the sign-up screen becomes the admin.
# After that, sign-up is closed and admins add team members from the Team page.
# Set to true only if you want anyone to be able to create a (member) account.
ALLOW_SIGNUP=false
